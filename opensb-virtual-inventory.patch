+bool PlayerInventory::consumeCurrency(String const& currencyType, uint64_t amount) {
+  if (m_currencies[currencyType] >= amount) {
+    m_currencies[currencyType] -= amount;
+    return true;
+  } else {
+    return false;
+  }
+}
