+static Maybe<ItemDescriptor> virtualInventoryDescriptor(Json const& json) {
+  if (!json.isType(Json::Type::Object) || !json.contains("name"))
+    return {};
+  try {
+    Json parameters = json.get("parameters", JsonObject());
+    if (!parameters.isType(Json::Type::Object))
+      parameters = JsonObject();
+    int64_t count = json.getInt("count", 1);
+    if (count <= 0)
+      return {};
+    return ItemDescriptor(json.getString("name"), (uint64_t)count, parameters);
+  } catch (std::exception const& e) {
+    Logger::warn("Player: invalid virtual inventory item descriptor: {}", outputException(e, false));
+    return {};
+  }
+}
+
+List<ItemDescriptor> Player::virtualInventoryItems() const {
+  List<ItemDescriptor> result;
+  if (!isMaster() || m_inVirtualInventoryCall)
+    return result;
+
+  m_inVirtualInventoryCall = true;
+  auto resetFlag = finally([this]() { m_inVirtualInventoryCall = false; });
+  for (auto const& p : m_genericScriptContexts) {
+    auto revision = p.second->invoke<Json>("virtualInventoryRevision");
+    if (!revision) {
+      m_virtualInventoryCache.remove(p.first);
+      continue;
+    }
+    auto cached = m_virtualInventoryCache.ptr(p.first);
+    if (!cached || !(cached->first == *revision)) {
+      List<ItemDescriptor> items;
+      if (auto list = p.second->invoke<Json>("virtualInventoryItems")) {
+        if (list->isType(Json::Type::Array)) {
+          for (auto const& entry : list->iterateArray()) {
+            if (auto descriptor = virtualInventoryDescriptor(entry))
+              items.append(descriptor.take());
+          }
+        }
+      }
+      m_virtualInventoryCache[p.first] = {*revision, std::move(items)};
+      cached = m_virtualInventoryCache.ptr(p.first);
+    }
+    result.appendAll(cached->second);
+  }
+  return result;
+}
+
+uint64_t Player::virtualInventoryCount(ItemDescriptor const& descriptor, bool exactMatch) const {
+  auto one = descriptor.singular();
+  uint64_t count = 0;
+  for (auto const& item : virtualInventoryItems()) {
+    if (one.matches(item, exactMatch))
+      count += item.count();
+  }
+  return count;
+}
+
+uint64_t Player::virtualInventoryConsume(ItemDescriptor const& descriptor, bool exactMatch) {
+  if (!isMaster() || m_inVirtualInventoryCall || descriptor.count() == 0)
+    return 0;
+
+  uint64_t consumed = 0;
+  m_inVirtualInventoryCall = true;
+  auto resetFlag = finally([this]() { m_inVirtualInventoryCall = false; });
+  for (auto const& p : m_genericScriptContexts) {
+    if (consumed >= descriptor.count())
+      break;
+    auto remaining = descriptor.withCount(descriptor.count() - consumed);
+    if (auto result = p.second->invoke<Json>("virtualInventoryConsume", remaining.toJson(), exactMatch)) {
+      if (result->canConvert(Json::Type::Int))
+        consumed += min<uint64_t>(remaining.count(), (uint64_t)max<int64_t>(0, result->toInt()));
+      // Revision is expected to change, but never trust a stale cache after a consume.
+      m_virtualInventoryCache.remove(p.first);
+    }
+  }
+  return consumed;
+}
+
+bool Player::canInterceptPickup(ItemPtr const& items) const {
+  if (!isMaster() || m_inVirtualInventoryCall || m_suppressPickupIntercept || !items || items->empty() || is<CurrencyItem>(items))
+    return false;
+
+  bool accepted = false;
+  m_inVirtualInventoryCall = true;
+  auto resetFlag = finally([this]() { m_inVirtualInventoryCall = false; });
+  auto descriptor = items->descriptor().toJson();
+  for (auto const& p : m_genericScriptContexts) {
+    if (p.second->invoke<bool>("canInterceptItemPickup", descriptor).value(false)) {
+      accepted = true;
+      break;
+    }
+  }
+  return accepted;
+}
+
+ItemPtr Player::interceptPickup(ItemPtr items) {
+  if (!isMaster() || m_inVirtualInventoryCall || m_suppressPickupIntercept || !items || items->empty() || is<CurrencyItem>(items))
+    return items;
+
+  auto itemDb = Root::singleton().itemDatabase();
+  m_inVirtualInventoryCall = true;
+  auto resetFlag = finally([this]() { m_inVirtualInventoryCall = false; });
+  for (auto const& p : m_genericScriptContexts) {
+    auto result = p.second->invoke<Json>("interceptItemPickup", items->descriptor().toJson());
+    // Function missing or errored, or explicitly declined: leave the items alone.
+    if (!result || (result->isType(Json::Type::Bool) && !result->toBool()))
+      continue;
+    if (result->isNull()) {
+      items = {};
+      break;
+    }
+    if (auto remainder = virtualInventoryDescriptor(*result)) {
+      if (remainder->count() < items->count())
+        items = itemDb->item(remainder.take());
+    } else {
+      items = {};
+      break;
+    }
+  }
+  return items;
 }
 
